# ========================================================
# CustomerSeg — Environment Variables Configuration
# ========================================================

# Backend Node.js
PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_2026

# Database (MySQL configuration)
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=customerseg_db

# Or for zero-setup local SQLite fallback:
# DB_CLIENT=sqlite3

# Python Machine Learning Microservice
ML_SERVICE_URL=http://127.0.0.1:8001

# CORS Allowed Origins (comma separated)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_BASE_URL=/api/v1
